Cell[CellGroupData[{

Cell["Forcing and ice speeds (combined, for context)", "Subsection",ExpressionUUID->"243cc409-88bf-4a4a-8222-8f8490025670"],

Cell[CellGroupData[{

Cell["\<\
plotForcingSpeeds = ListLinePlot[{Transpose[{tHours, windSpeedMean}], \
Transpose[{tHours, currentSpeedMean}], Transpose[{tHours, iceSpeedMean}]},
  PlotLegends -> {\"wind\", \"current\", \"ice\"},
  PlotStyle -> {Directive[Orange, Thick], Directive[Blue, Thick], \
Directive[Black, Thick]},
  Frame -> True, FrameLabel -> {\"time (h)\", \"speed (m/s)\"},
  PlotLabel -> \"Forcing and ice speeds over masked region\", ImageSize -> \
650]\
\>", "Input",
 CellLabel->"In[50]:=",ExpressionUUID->"962f87ec-1b3d-4448-8f05-187c84221d5c"],

