Cell[CellGroupData[{

Cell["Ice speed (standalone)", "Subsection",ExpressionUUID->"33250784-9739-4d32-a4a3-694d25109821"],

Cell[CellGroupData[{

Cell["\<\
plotIceSpeed = ListLinePlot[{Transpose[{tHours, iceSpeedMean}], \
Transpose[{tHours, iceSpeedMax}]},
  PlotLegends -> {\"mean\", \"max\"},
  PlotStyle -> {Directive[Black, Thick], Directive[Black, Thick, Dashed]},
  Frame -> True, FrameLabel -> {\"time (h)\", \"ice speed (m/s)\"},
  PlotLabel -> \"Ice speed over masked region\", ImageSize -> 650]\
\>", "Input",
