Notebook[{

Cell[CellGroupData[{
Cell["Elliptic Fracture Surface", "Title",ExpressionUUID->"0751e8e2-66d7-44cb-bc74-80797956e105"],

Cell["\<\
Draws the elliptic yield/fracture surface used for ice in (p, q) \
stress-invariant space:
q(p) = 2 Sqrt[(pmax - p)(p - pmin)] qmax / (pmax - pmin)
and computes q(p = 0), the shear capacity at zero pressure. Edit pMinVal, \
pMaxVal, qMaxVal (all in Pascals) in the Input cell below and re-evaluate the \
notebook (Evaluate Notebook, in the Evaluation menu) to try other values.\
\>", "Text",ExpressionUUID->"f826cba1-aebc-4968-ae45-f84baecdf752"],

Cell[CellGroupData[{

Cell["Parameters (edit and re-evaluate)", "Section",ExpressionUUID->"3884b535-43b0-414f-aba6-9d89435c0c63"],

Cell["\<\
Defaults below match the project's current calibrated values \
(IceTensileStrength, IceCompressiveStrength, IceShearStrength in \
simulation.json / base_config.json).\
\>", "Text",ExpressionUUID->"0851ea73-ef93-441d-8a35-2dbe0cfa5405"],

Cell["\<\
pMinVal = -3.4*10^5;   (* pmin, e.g. -IceTensileStrength; can be negative \
(tension side) *)
pMaxVal = 30*10^6;      (* pmax, e.g. IceCompressiveStrength *)
qMaxVal = 3.4*10^5;     (* qmax, e.g. IceShearStrength -- peak of the ellipse \
*)\
\>", "Input",
 CellChangeTimes->{{3.994457620925527*^9, 3.994457646368906*^9}, {
   3.99445789779196*^9, 3.994457932608252*^9}, {3.9944579674604807`*^9, 
   3.994458012425706*^9}, 3.994458076636059*^9, 3.9944581791993427`*^9, {
   3.9944582145633574`*^9, 3.9944582168016777`*^9}, {3.994458247326447*^9, 
   3.994458268065558*^9}, {3.994643455313259*^9, 3.994643464338479*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"f963ecbe-0c16-4f7e-b7ce-59b7ea194ce2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Elliptic Yield Surface", "Section",ExpressionUUID->"db70085f-cce4-4acb-b406-5665cf092709"],

Cell["\<\
qEllipse[p_, pmin_, pmax_, qmax_] := 2 Sqrt[Max[0, (pmax - p) (p - pmin)]] \
qmax/(pmax - pmin)\
\>", "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"6e8d30fe-7f39-40bf-a815-0945bfe94a22"]
}, Open  ]],

Cell[CellGroupData[{

Cell["q at p = 0", "Section",ExpressionUUID->"a1fa9dfc-3c1b-4ec5-9e62-e8411fe82b4e"],

Cell[CellGroupData[{

Cell["\<\
qAtZero = N[qEllipse[0, pMinVal, pMaxVal, qMaxVal]];
Print[\"q(p = 0) = \", qAtZero, \" Pa\"]\
\>", "Input",
 CellChangeTimes->{{3.9944580238163643`*^9, 3.994458044093582*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"e5a8e054-d6ec-411b-ab7e-19dc7c59bb49"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"q(p = 0) = \"\>", "\[InvisibleSpace]", "71580.28482146667`", 
   "\[InvisibleSpace]", "\<\" Pa\"\>"}],
  SequenceForm["q(p = 0) = ", 71580.28482146667, " Pa"],
  Editable->False]], "Print",
 CellChangeTimes->{
  3.9944574588744783`*^9, 3.994457650415757*^9, 3.994457901151649*^9, 
   3.994457936740778*^9, 3.99445797972309*^9, {3.99445801534584*^9, 
   3.994458044545038*^9}, 3.994458079398872*^9, 3.9944581848765783`*^9, 
   3.994458220135214*^9, {3.9944582522885103`*^9, 3.994458271106526*^9}, 
   3.994643470008686*^9},
 CellLabel->
  "During evaluation of \
In[5]:=",ExpressionUUID->"e31aa7a2-47e8-4f14-91b8-cdea209c6bd5"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "qAtZero"}], "/", "pMinVal"}]], "Input",
 CellChangeTimes->{{3.994458227382601*^9, 3.9944582370987673`*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"fe5f7ced-9bbc-49ec-9af1-ad3f098d6093"],

Cell[BoxData["0.21053024947490198`"], "Output",
 CellChangeTimes->{{3.9944582379193993`*^9, 3.9944582711213007`*^9}, 
   3.9946434700272703`*^9},
 CellLabel->"Out[7]=",ExpressionUUID->"0901164b-ce79-40b5-a613-5781cf91bd64"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Plot", "Section",ExpressionUUID->"55c5beba-f46d-4d35-abff-9775af21c881"],

Cell["\<\
The red point marks (p = 0, q(p = 0)), with dashed guide lines to both axes.\
\>", "Text",ExpressionUUID->"9aa4ba28-4a81-42ca-81a9-54f8330a0071"],

Cell[CellGroupData[{

Cell["\<\
Plot[qEllipse[p, pMinVal, pMaxVal, qMaxVal], {p, pMinVal, pMaxVal},
  PlotRange -> {{pMinVal, pMaxVal}, {0, qMaxVal*1.1}},
  Frame -> True, FrameLabel -> {\"p  (Pa)\", \"q  (Pa)\"},
  PlotLabel -> \"Elliptic fracture surface   |   q(p = 0) = \" <> \
ToString[NumberForm[qAtZero, 6]] <> \" Pa\",
  PlotStyle -> Directive[Black, Thick],
  Epilog -> {Red, PointSize[0.015], Point[{0, qAtZero}],
    Dashed, Line[{{0, 0}, {0, qAtZero}}], Line[{{pMinVal, qAtZero}, {0, \
qAtZero}}]},
  ImageSize -> 650, PlotPoints -> 200]\
\>", "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"043d6f85-e472-42e6-b80e-c68094c86adb"],

