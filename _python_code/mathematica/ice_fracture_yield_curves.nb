   3.9950716079593477`*^9},
 CellLabel->"Out[81]=",ExpressionUUID->"b24b87d5-eab0-4ed9-8806-028fc7eb5d90"]
}, Open  ]],

Cell[CellGroupData[{

Cell["qIntact[compressiveThreshold]", "Input",
 CellLabel->"In[82]:=",ExpressionUUID->"3b867cfa-8aea-4ebf-bbc8-33a987574d3f"],

Cell[BoxData["115.0796877634916`"], "Output",
