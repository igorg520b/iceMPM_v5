Cell[CellGroupData[{

Cell["Step 6: define qIntact[p] and test it at three points", "Section",ExpressionUUID->"87521c40-1de8-4127-ba5d-a91886fd12e5"],

Cell["\<\
qIntact[p_] := If[p <= 0, (q0/tensileT)*(p + tensileT), q0 + \
fractureAngleTan*p]\
\>", "Input",
 CellLabel->"In[79]:=",ExpressionUUID->"72ce4ee2-3e00-4469-bd04-a84c0d95a683"],

Cell["\<\
Expected: 0 at p = -tensileT, q0 at p = 0, and something above q0 at the \
compressive threshold.\
\>", "Text",ExpressionUUID->"2981709e-28b1-4b3d-9a8d-0e76a1710fbc"],

Cell[CellGroupData[{

Cell["qIntact[-tensileT]", "Input",
 CellLabel->"In[80]:=",ExpressionUUID->"7fb8cb72-b4b5-43dd-8a67-c7469d222fde"],

Cell[BoxData["0.`"], "Output",
 CellChangeTimes->{
  3.995068582104125*^9, 3.995068686080052*^9, {3.995070341442024*^9, 
   3.995070351725119*^9}, 3.9950709252312927`*^9, 3.995071465052902*^9, 
   3.995071607949194*^9},
 CellLabel->"Out[80]=",ExpressionUUID->"1ec6b351-d27e-4dbc-8c79-a877e53c0c93"]
}, Open  ]],

