 CellLabel->"Out[82]=",ExpressionUUID->"fbc28eeb-fdaa-42a2-9ede-c44d32846f99"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Step 7: define qYield[p, cf] and test it at a few points", "Section",ExpressionUUID->"47f6a30a-98bd-47a0-b64d-0e3a68f3fe54"],

Cell["\<\
qYield[p_, cf_] := Which[
   p < dpThresholdP, 0,
   True, Min[(p - dpThresholdP)*dpTanPhi,
             qIntersect*cf + yieldFrictionTan*(p - dpThresholdP - \
(qIntersect*cf)/dpTanPhi)]
]\
\>", "Input",
 CellLabel->"In[83]:=",ExpressionUUID->"aa796dad-7c5b-4bc1-87bd-4d23e946f284"],

Cell["\<\
Expected: 0 below dpThresholdP, small near p = 0, and qCrossoverFresh / \
qCrossoverResidual (computed in Step 5) right at pCrossoverFresh / \
pCrossoverResidual.\
\>", "Text",ExpressionUUID->"f39fa77c-c85d-447b-abf9-857f679e67e4"],

