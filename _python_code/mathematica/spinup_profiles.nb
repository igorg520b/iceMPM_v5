Notebook[{

Cell[CellGroupData[{
Cell["Sea-Ice Thermal Spin-Up: Vertical Temperature Profiles", "Title",ExpressionUUID->"c5d55250-d58b-4955-8570-39f583b83ae0"],

Cell["\<\
Visualizes the reconstructed vertical temperature profile T(z) (see \
heat_equation_spec.md, formula (R)) for a sample of points printed to console \
by DataPreparer::ThermalSpinUpSave (preparer/data_preparer.cpp) after a \
thermal spin-up run. Each row below is one point: {A1, A2, A3, Ts_old, H}. \
Paste the latest printed line into the data list, then evaluate the whole \
notebook (Evaluation > Evaluate Notebook).\
\>", "Text",ExpressionUUID->"10b2c78e-c0d9-4727-bdb0-128413768521"],

Cell[CellGroupData[{

Cell["Constants and reconstruction formula", "Section",ExpressionUUID->"e2b0f5ff-d7d3-4808-9b2d-979c2aa2e834"],

Cell["\<\
Tb = -1.8; (* deg C, fixed ocean/bottom boundary temperature, see \
SimParams::T_bottom *)
T[z_, Ts_, A1_, A2_, A3_, H_] := Ts + (Tb - Ts) z/H + A1 Sin[Pi z/H] + A2 \
Sin[2 Pi z/H] + A3 Sin[3 Pi z/H];\
\>", "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"b7415967-7b15-435a-9032-60a744c46e2b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Sample data", "Section",ExpressionUUID->"99fdea51-69b7-474b-aea2-d76d54d5c846"],

Cell["\<\
(* Each row: {A1, A2, A3, Ts_old, thickness H}, printed by ThermalSpinUpSave *)
data = {{-0.627062,0.0536493,0.0672274,-0.563635,1.12249},{-2.18392,-0.687443,\
-0.307011,-0.190771,2.26634},{-1.48361,-0.261503,-0.0696807,-0.00281372,1.\
93188},{-2.97215,-0.93694,-0.252556,0.012262,1.71462},{-1.06757,-0.0440154,0.\
0415906,-0.88465,1.87907},{-3.19858,-1.25852,-0.490699,-0.97251,2.14298},{-0.\
606172,0.0570905,0.0500691,-0.792426,0.992328},{-3.42853,-1.11753,-0.515712,-\
0.00662842,2.64699},{-1.62957,-0.243458,-0.0597387,-0.110297,1.92241},{-1.\
19218,-0.152271,0.0256091,-0.76261,1.85453}};
(* NOTE: the thicknesses above are placeholders (1.0) -- the printed sample 
   this notebook was first built from predates adding H to the debug print. 
   Replace this whole list with the new {A1,A2,A3,Ts,H} output. *)\
\>", "Input",
 CellChangeTimes->{{3.9937002720885878`*^9, 3.993700277373192*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"f56730bf-2b6e-497d-847f-713394462543"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Vertical profiles (depth 0 = surface, H = ocean boundary)", "Section",ExpressionUUID->"6a456871-8f76-498d-8abb-7f6e72098aac"],

Cell[CellGroupData[{

Cell["\<\
profiles = Table[
  With[{A1 = data[[i, 1]], A2 = data[[i, 2]], A3 = data[[i, 3]], Ts = \
data[[i, 4]], H = data[[i, 5]]},
    Legended[
      ParametricPlot[{T[z, Ts, A1, A2, A3, H], -z}, {z, 0, H}, PlotStyle -> \
ColorData[97][i]],
      \"Point \" <> ToString[i]
    ]
  ],
  {i, Length[data]}
];

Show[profiles, PlotRange -> All, Frame -> True,
 FrameLabel -> {\"Temperature (deg C)\", \"Depth (m, 0 = surface)\"},
 PlotLabel -> \"Reconstructed vertical temperature profiles (formula R)\",
 ImageSize -> 650]\
\>", "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"962b6bf1-9e38-453c-836b-ae17376cd6ef"],

